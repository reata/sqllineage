{
  "name": "sqllineagejs",
  "version": "1.5.8",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^7.2.0",
    "@mui/x-tree-view": "^9.11.0",
    "@reduxjs/toolkit": "^2.12.0",
    "cytoscape": "^3.34.1",
    "cytoscape-dagre": "^4.0.0",
    "react": "^19.2.8",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
